#include <stdio.h>

int main()
{
    int a,i;
    int b=0;
    
    
    printf("enter the number: ");
    scanf("%d", &a);
    
    for(i=2;i<a;i++){
    
        if(a%i==0){
            b++;
        }

    }
    if(a>1 && b==0){
        printf("%d, is a prime number",a);
    
    }
    else{
        printf("%d not a prime number",a);
    }
    return 0;
}