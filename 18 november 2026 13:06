#include <stdio.h>

int main()
{
    int array[]={4,65,8,-9,22,-1000};
    int n;
    n=sizeof(array)/sizeof(array[0]);
    int i;

    int max=array[0];
    int min=array[0];
    
    for(i=0;i<n;i++){
        
        
        if(array[i]>max){
            
            max=array[i];
            
            
        }
        
        
    }
    
    printf("max=%d\n", max);
    
    for(i=0;i<n;i++){
        if(array[i]<min){
            min=array[i];
        
        }
        
    }
    printf("min=%d",min);

    return 0;
}