#include<stdio.h>
int main(void){
    int x;
    printf("enter a number: ");
    scanf("%d", &x);
    if(x>=-9 && x<=9){
        printf("%d is a one digit number.", x);
    }
    else if(x>=-99 && x<=99){
        printf("%d is a two digit number.", x);
    } 
    else {
        printf("%d has more than two digits.", x);
    }
    return 0;
}