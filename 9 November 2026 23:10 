#include<stdio.h>
int main()
{
   int x;
   int i;
   int b;
   int last;
   int first;
   
   printf("enter a number:");
   scanf("%d",&x);
   
   b=1;
   i=x;
   last=x%10;
   while(1){
       if(x/10==0){
           first=x;
           break;
       }
       x/=10;
       
       b*=10;
   }
   
   b=b - 1;
   last*=b;
   b=-b;
   first*=b;
   
   
   
   printf("%d",i+last+first);
   

   return 0;
}