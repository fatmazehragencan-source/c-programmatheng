#include <stdio.h>

int main()
{
    int array1[3]={1,2,3};
    int array2[2]={4,5};
    int array3[5];
    int i;
    int n1=3;
    int n2=2;
    int n3=5;

    
    for(i=0;i<n1;i++){
        array3[i]=array1[i];
        
    }
    
    for(i=0;i<n2;i++){
        array3[i+n1]=array2[i];
    }
    
    for(i=0;i<n3;i++){
        printf("%2d",array3[i]);
    }


    return 0;
}