#include<stdio.h>
int main(void){
    int x;
    printf("enter a number: ");
    scanf("%d", &x);
    if(x%3==0 && x%5==0){
        printf("%d divisible by both 3 and 5.",x);
    }
    else if(x%3==0){
        printf("%d divisible by 3.", x );
    }
    else if(x%5==0){
        printf("%d divisible by 5.", x);
    }
    else{
        printf("%d not divisible by 3 or 5.", x );
        
    }
    return 0;
}