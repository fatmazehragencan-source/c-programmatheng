#include<stdio.h>
int main(void)
{
    char x;
    printf("enter a character: ");
    scanf(" %c", &x);
    if(x=='a'||x=='e'||x=='i'||x=='u'||x=='o'||x=='A'||x=='E'||x=='I'||x=='O'||x=='U'){
        printf("%c is a vowel. ",x);
    }
    else if(x>='a' && x<='z' || x>='A' && x<='Z'){
        printf("%c is a consonant.",x);
    }
    else{
        printf("%c is not a letter.",x);
    }
    return 0;
}